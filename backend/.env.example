# SupplyKey backend configuration
# Copy this file to backend/.env. The backend loads backend/.env automatically.
# Values supplied by the OS/deployment environment override this file.

APP_ENV=development
DATABASE_URL=sqlite:///./supplykey.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://supplykey:CHANGE_ME@localhost:5432/supplykey

SUPPLYKEY_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EVIDENCE_STORAGE_DIR=./private-evidence
WORKER_SECRET=replace-with-a-separate-random-worker-secret-at-least-32-characters
WORKER_INTERVAL_SECONDS=60

# Keep simulated until Paga Sandbox credentials and HTTPS callbacks are configured.
PAYMENT_PROVIDER=simulated
SIMULATED_PAYMENT_SCENARIO=PENDING
SIMULATED_INSTRUCTION_SCENARIO=PENDING

# Paga Engine Sandbox configuration.
# To enable: set PAYMENT_PROVIDER=paga and PAGA_MODE=sandbox, then fill in keys.
PAGA_MODE=disabled
PAGA_PUBLIC_KEY=
PAGA_SECRET_KEY=
PAGA_HASH_KEY=
PAGA_CALLBACK_URL=https://YOUR_PUBLIC_HTTPS_HOST/api/v1/webhooks/paga/subsidiary-account
PAGA_PAYOUT_CALLBACK_URL=https://YOUR_PUBLIC_HTTPS_HOST/api/v1/webhooks/paga/bank-transfer
PAGA_BUSINESS_NAME=SupplyKey Sandbox
PAGA_TIMEOUT_SECONDS=15
# Must be a separate random secret (at least 32 chars) and differ from SUPPLYKEY_SECRET in production.
PAYOUT_ENCRYPTION_KEY=replace-with-a-separate-random-secret

# Live mode remains blocked until written provider and Nigerian legal approval.
PAGA_CONDITIONAL_CUSTODY_APPROVED=false
PAGA_LEGAL_APPROVAL_REFERENCE=
